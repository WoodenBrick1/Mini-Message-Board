<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mini Message Board</title>
</head>
<body>
    <a href="./new">Add Message</a>

    <div id='messages'>
        <% messages.forEach((message, index) => { %>
            <div class='message'>
                <p><%= message.text %></p>
                <a href=<%= '/message/' + index %>>More Info</a>
            </div>  
        <% }); %>
    </div>
    
</body>
</html>