<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
</head>
<body>
    <a href="./new">Add Message</a>

    <% messages.forEach(message => { %>
       <%- include('components/message', {text: message.text,
                                          user: message.user,
                                          date: message.added}) %>
    <% }); %>
</body>
</html>